# site-internet — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs

# Base URL du site (pour les meta tags, sitemap, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (optionnel)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Formspree (contact form)
NEXT_PUBLIC_FORMSPREE_ID=xplaceholder

# Calendly (booking embed)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/leadmind-ai/30min
